{
  // Cloudflare config: the website files in ./dist plus a small Worker (worker/index.ts) that handles /api/* requests.
  "name": "mala-royale-optimized",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "FIREBASE_PROJECT_ID": "mala-royale",
    "FIREBASE_API_KEY": "AIzaSyDvtgycbt3lbqPEuTt3tbWm3QZIFIfJQpM",
    "DEVELOPER_EMAILS": "allinoneaideveloper2026@gmail.com",
    "OWNER_EMAILS": "allinoneaideveloper2026@gmail.com",
    "SHOP_NAME": "Mala Royale",
    "SITE_URL": "https://mala-royale-optimized.workers.dev",
    // Notifications are OFF until you change these (see DEPLOY_CLOUDFLARE.md). Email: "gmail" or "resend". WhatsApp: "cloud".
    "EMAIL_PROVIDER": "off",
    "WHATSAPP_PROVIDER": "off",
    "PUSH_PROVIDER": "off",
    // Smart search and the shopping assistant. Set ASSISTANT_ENABLED to "false" to switch both off.
    "ASSISTANT_ENABLED": "true"
  }
}
