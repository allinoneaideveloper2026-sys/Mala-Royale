VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
# Comma-separated. Must match the lists at the top of firestore.rules (npm run check:config verifies this).
VITE_OWNER_EMAILS=owner@your-domain.com
VITE_DEVELOPER_EMAILS=developer@your-domain.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Optional server-side courier serviceability endpoint. Keep carrier API credentials on that server.
# VITE_PINCODE_PROXY_URL=https://your-domain.example/api/pincode-serviceability
# Optional: a separate unsigned Cloudinary preset (image only, 5 MB max, folder payment-proofs) for customer payment screenshots.
VITE_CLOUDINARY_PROOF_PRESET=
