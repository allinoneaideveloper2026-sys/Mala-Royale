rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A Google account with a verified email (hosts, developer, and customers who signed in with Google).
    function signedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    // Any session, including guest customers who ordered without an account.
    function hasSession() {
      return request.auth != null;
    }

    // EDIT THESE TWO LISTS ONLY. They must match VITE_DEVELOPER_EMAILS / VITE_OWNER_EMAILS
    // (run `npm run check:config` to verify). Use lower-case emails.
    function developerEmails() {
      return ['allinoneaideveloper2026@gmail.com'];
    }

    function ownerEmails() {
      return ['owner@malaroyale.com'];
    }

    function isDeveloper() {
      return signedIn() && request.auth.token.email in developerEmails();
    }

    function isOwner() {
      return signedIn() && (
        request.auth.token.email in ownerEmails() ||
        exists(/databases/$(database)/documents/hostAccess/$(request.auth.token.email))
      );
    }

    function isStaff() {
      return isDeveloper() || isOwner();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isStaff();
      // Staff can change anything. A customer may only LOWER the quantity, by at most 10, and only in the
      // same write that creates their own brand-new order (this is how stock is blocked when an order is placed).
      allow update: if isStaff() || (
        hasSession()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastReservationOrderId'])
        && resource.data.get('quantity', null) is number
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity < resource.data.quantity
        && resource.data.quantity - request.resource.data.quantity <= 10
        && request.resource.data.lastReservationOrderId is string
        && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastReservationOrderId))
        && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastReservationOrderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastReservationOrderId)).data.userId == request.auth.uid
      );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /orders/{orderId} {
      allow create: if hasSession()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courierNoticeAccepted == true
        // Payment screenshots must be Cloudinary links (or empty), never another website.
        && request.resource.data.get('itemPayment', {}).get('screenshotUrl', '') is string
        && (
          request.resource.data.get('itemPayment', {}).get('screenshotUrl', '') == ''
          || request.resource.data.itemPayment.screenshotUrl.matches('^https://res[.]cloudinary[.]com/.+')
        );
      allow read: if isStaff() || (hasSession() && resource.data.userId == request.auth.uid);
      allow update: if isStaff() || (
        hasSession()
        && resource.data.userId == request.auth.uid
        && resource.data.get('courierBill', null) != null
        && resource.data.get('courierPayment', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courierPayment', 'updatedAt'])
        && request.resource.data.courierPayment.keys().hasOnly(['paymentId', 'kind', 'amount', 'utr', 'screenshotUrl', 'verified', 'submittedAt'])
        && request.resource.data.courierPayment.kind == 'COURIER'
        && request.resource.data.courierPayment.amount == resource.data.courierBill.amount
        && request.resource.data.courierPayment.utr.matches('^[0-9]{12}$')
        && request.resource.data.courierPayment.verified == false
        && request.resource.data.courierPayment.screenshotUrl is string
        && (
          request.resource.data.courierPayment.screenshotUrl == ''
          || request.resource.data.courierPayment.screenshotUrl.matches('^https://res[.]cloudinary[.]com/.+')
        )
        && request.resource.data.courierPayment.submittedAt is string
      ) || (
        // After the host cancels an order, the customer may add where the refund should go (once).
        hasSession()
        && resource.data.userId == request.auth.uid
        && resource.data.stage == 'NOT_ACCEPTED'
        && resource.data.get('refundDetails', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundDetails', 'updatedAt'])
        && request.resource.data.refundDetails.keys().hasOnly(['method', 'value', 'submittedAt'])
        && request.resource.data.refundDetails.submittedAt is string
        && request.resource.data.refundDetails.value is string
        && (
          (request.resource.data.refundDetails.method == 'UPI_PHONE'
            && request.resource.data.refundDetails.value.matches('^[6-9][0-9]{9}$'))
          || (request.resource.data.refundDetails.method == 'UPI_ID'
            && request.resource.data.refundDetails.value.matches('^[A-Za-z0-9._-]{2,64}@[A-Za-z][A-Za-z0-9]{1,30}$'))
        )
      );
      allow delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow get: if hasSession() && (
        resource == null || resource.data.userId == request.auth.uid || isStaff()
      );
      allow list: if false;
      allow create: if hasSession() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Customer enquiries from the website chat form. Only staff can read or manage them.
    match /enquiries/{enquiryId} {
      allow create: if hasSession()
        && request.resource.data.keys().hasOnly(['userId', 'name', 'phone', 'message', 'productId', 'productName', 'kind', 'orderId', 'issueType', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'name', 'phone', 'message', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'NEW'
        // A payment report must point at one of the customer's own orders.
        && (!('orderId' in request.resource.data) || (
          request.resource.data.kind == 'PAYMENT_ISSUE'
          && request.resource.data.orderId is string
          && request.resource.data.get('issueType', '') is string
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        ))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10,15}$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is string
        && (!('productName' in request.resource.data) || request.resource.data.productName.size() <= 120);
      allow read, update, delete: if isStaff();
    }

    // Private host data (the assistant's learned preferences). Staff only.
    match /hostPrivate/{docId} {
      allow read, write: if isStaff();
    }

    // Customer feedback from the About page. Only staff can read or manage it.
    match /feedback/{feedbackId} {
      allow create: if hasSession()
        && request.resource.data.keys().hasOnly(['userId', 'name', 'text', 'sentiment', 'category', 'confidence', 'language', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'text', 'sentiment', 'category', 'confidence', 'language', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'NEW'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.sentiment in ['POSITIVE', 'NEGATIVE', 'SUGGESTION', 'NEUTRAL']
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.confidence is number
        && request.resource.data.language is string
        && request.resource.data.createdAt is string
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 80);
      allow read, update, delete: if isStaff();
    }

    match /hostAccess/{email} {
      allow get: if isStaff() || (signedIn() && request.auth.token.email == email);
      allow list: if isDeveloper();
      allow create, update: if isDeveloper() && request.resource.data.email == email;
      allow delete: if isDeveloper();
    }

    // Saved addresses need a Google account so they follow the customer across devices.
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
