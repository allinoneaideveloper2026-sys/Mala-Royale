# Cloudflare Pages (and Netlify) read this file. It adds security headers and sets caching.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Report-Only first: it logs problems in the browser console without blocking anything.
  # After a few days with no violations in the console, rename it to Content-Security-Policy.
  # (Do NOT add Cross-Origin-Opener-Policy: same-origin; it breaks the Google sign-in popup.)
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com; media-src 'self' blob: https://res.cloudinary.com; connect-src 'self' https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://api.cloudinary.com https://api.postalpincode.in; frame-src https://accounts.google.com https://*.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite adds a content hash to everything in /assets, so it can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page shell must always be re-checked so visitors get new deployments quickly.
/index.html
  Cache-Control: no-cache
